# Copy this file to .streamlit/secrets.toml and replace the placeholders.
# On Streamlit Cloud, paste these values into the Secrets UI instead.

[mysql]
host = "gateway01.ap-northeast-1.prod.aws.tidbcloud.com"
port = 4000
user = "your_cluster.root"
password = "replace_with_rotated_password"
database = "employee_analytics"
ssl_enabled = true
ssl_verify_cert = true
# Path relative to the project root. The bundled isrgrootx1.pem is the
# ISRG Root X1 CA used by TiDB Cloud.
ssl_ca = "isrgrootx1.pem"
pool_size = 3
